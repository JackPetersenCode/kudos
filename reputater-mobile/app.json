{
  "expo": {
    "name": "Reputater",
    "slug": "reputater-mobile",
    "scheme": "reputater",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#171717"
    },
    "extra": {
      "apiBaseUrl": "https://api.reputater.com/api",
      "router": {},
      "eas": {
        "projectId": "b17091b1-9cc7-4c37-a847-4424c1d09046"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reputater.app",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:reputater.com",
        "applinks:www.reputater.com"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Reputater uses your location to show businesses near you.",
        "NSPhotoLibraryUsageDescription": "Reputater needs access to your photo library so you can attach photos to reviews and business listings."
      }
    },
    "android": {
      "package": "com.reputater.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "reputater.com"
            },
            {
              "scheme": "https",
              "host": "www.reputater.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Reputater uses your location to show businesses near you."
        }
      ]
    ],
    "owner": "mama-dog-llc"
  }
}
