{
  "expo": {
    "name": "Reputater",
    "slug": "reputater-mobile",
    "scheme": "reputater",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "extra": {
      "apiBaseUrl": "https://kudos-production.up.railway.app/api"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reputater.app",
      "associatedDomains": [
        "applinks:reputater.com",
        "applinks:www.reputater.com"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Reputater uses your location to show businesses near you.",
        "NSPhotoLibraryUsageDescription": "Reputater needs access to your photo library so you can attach photos to reviews and business listings."
      }
    },
    "android": {
      "package": "com.reputater.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "reputater.com" },
            { "scheme": "https", "host": "www.reputater.com" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Reputater uses your location to show businesses near you."
        }
      ]
    ]
  }
}
